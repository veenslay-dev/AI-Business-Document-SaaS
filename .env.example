# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL, used for auth redirects and share links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI provider: openai | anthropic
AI_PROVIDER=anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: route through a gateway or proxy
# OPENAI_BASE_URL=
# ANTHROPIC_BASE_URL=
AI_MODEL_OPENAI=gpt-4o-mini
AI_MODEL_ANTHROPIC=claude-sonnet-4-5

# Used to hash viewer IPs for document tracking. Any long random string.
IP_HASH_SALT=change-me

# Set to "on" to enforce plan limits (free: 3 documents a month, no AI). Off until billing is connected.
BILLING_ENFORCEMENT=

# Optional Google PageSpeed Insights key for SEO audits (works without, with lower quota)
PAGESPEED_API_KEY=

# Chromium for PDF generation. Leave empty on serverless hosts (uses @sparticuz/chromium).
# Set to a local Chrome/Chromium binary when self-hosting or developing.
PDF_CHROMIUM_PATH=
