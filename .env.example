# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL, used for auth redirects and share links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI provider: openai | anthropic
AI_PROVIDER=anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: route through a gateway or proxy
# OPENAI_BASE_URL=
# ANTHROPIC_BASE_URL=
AI_MODEL_OPENAI=gpt-4o-mini
AI_MODEL_ANTHROPIC=claude-sonnet-4-5

# Used to hash visitor IPs. Set a long random value (32+ characters) and never reuse it elsewhere.
IP_HASH_SALT=

# Plan limits are enforced by default. Set to "off" only for a local demo.
BILLING_ENFORCEMENT=

# A second admin (confirmed email). The first account ever created is always the admin.
ADMIN_EMAIL=

# Admin cost pages: your model's price per million tokens in US dollars, and the exchange rate.
AI_COST_INPUT_PER_M_USD=0.15
AI_COST_OUTPUT_PER_M_USD=0.60
USD_TO_INR=88

# Shown on the public contact page
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional Google PageSpeed Insights key for SEO audits (works without, with lower quota)
PAGESPEED_API_KEY=

# Chromium for PDF generation. Leave empty on serverless hosts (uses @sparticuz/chromium).
# Set to a local Chrome/Chromium binary when self-hosting or developing.
PDF_CHROMIUM_PATH=

# Razorpay online payments (all server side, never prefix with NEXT_PUBLIC_). Leave blank to keep the contact-form upgrade flow.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Shown on the Terms, Privacy and Refund pages. Leave blank to show only the product name.
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_ADDRESS=
# City whose courts the Terms name, for example Mumbai. Blank means "courts of competent jurisdiction in India".
NEXT_PUBLIC_LEGAL_JURISDICTION=
